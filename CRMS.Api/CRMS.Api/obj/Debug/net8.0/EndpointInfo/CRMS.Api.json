{
  "openapi": "3.0.1",
  "info": {
    "title": "CRMS.Api",
    "version": "1.0"
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "CRMS.Api"
        ],
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "CRMS.Api"
        ],
        "operationId": "GetUsers",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/cars": {
      "get": {
        "tags": [
          "CRMS.Api"
        ],
        "operationId": "GetCars",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "CRMS.Api"
        ],
        "operationId": "AddCar",
